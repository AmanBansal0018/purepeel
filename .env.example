# Gmail that SENDS the alerts (create a Google App Password: Google Account > Security > 2-Step Verification > App passwords)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your_16_char_app_password
# Inbox that RECEIVES every enquiry (can be the same Gmail)
CONTACT_TO=your-gmail@gmail.com
# Secret to view saved enquiries at /api/inquiries?key=...
ADMIN_KEY=change-me
